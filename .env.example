# Compiler and task model. Verified CRUD tools run without any model.
# Backends: anthropic (official SDK), codex (signed-in Codex CLI), http (OpenAI-compatible endpoint).
# Leave CONDUIT_MODEL_BACKEND empty to pick anthropic when ANTHROPIC_API_KEY is set,
# else codex when the CLI is installed, else http.
CONDUIT_MODEL_BACKEND=anthropic
CONDUIT_MODEL=claude-opus-5
# Anthropic key. CONDUIT_MODEL_API_KEY is used instead when set.
ANTHROPIC_API_KEY=
CONDUIT_MODEL_API_KEY=
# Only for organization-level keys with no workspace: the workspace id (wrkspc_...) Anthropic should bill.
ANTHROPIC_WORKSPACE_ID=
# Reasoning effort for the anthropic backend: low, medium, high, xhigh, max.
CONDUIT_MODEL_EFFORT=high
CONDUIT_MODEL_MAX_TOKENS=16000
# Set to 0 to disable schema-enforced JSON output on the anthropic backend.
CONDUIT_MODEL_STRUCTURED=1
# http backend only.
CONDUIT_MODEL_BASE_URL=
# Optional path if codex is installed but is not on PATH.
CONDUIT_CODEX_PATH=
# Optional browser channel: msedge, chrome, or leave unset for automatic discovery.
# Use chrome for Microsoft or Google sign-ins when a signed-in Edge profile is open.
CONDUIT_BROWSER_CHANNEL=
# Optional isolated Python executable with Crawl4AI; used only during learning/repair/optimization.
CONDUIT_CRAWL4AI_PYTHON=
